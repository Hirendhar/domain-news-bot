# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Required ──────────────────────────────────────────────────────
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email Notifications (optional) ───────────────────────────────
# How to get a Gmail App Password:
#   Google Account → Security → 2-Step Verification → App passwords
#   Create one named "Domain News Bot" → copy the 16-char password
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_EMAIL_TO=you@gmail.com

# ── AI Personalisation (optional) ────────────────────────────────
# Tell Gemini what you care about to improve summary relevance
# e.g. "Focus on aftermarket domain sales and ccTLD policy changes"
USER_CONTEXT=
