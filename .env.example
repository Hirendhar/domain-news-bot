# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Required ──────────────────────────────────────────────────────
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email Notifications (optional) ───────────────────────────────
# RECOMMENDED for GitHub Actions: a transactional SMTP provider (Brevo).
# Gmail blocks app-password logins from datacenter IPs, so Gmail only works
# when you run the bot locally. Brevo's free tier = 300 emails/day.
#
# Brevo setup: sign up at brevo.com → SMTP & API → SMTP → copy the
#   "login" and generate an SMTP key. Verify your sender address too.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxxxxxx@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=you@gmail.com          # a sender you verified in Brevo
NOTIFY_EMAIL_TO=you@gmail.com     # where alerts are delivered

# ── Gmail fallback (local use only — leave blank if using SMTP_* above) ──
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── AI Personalisation (optional) ────────────────────────────────
# Tell Gemini what you care about to improve summary relevance
# e.g. "Focus on aftermarket domain sales and ccTLD policy changes"
USER_CONTEXT=

# ── AI Article Writing (optional) ────────────────────────────────
# After summarising, the bot can also WRITE a full ~400-600 word original
# article for each new item (grounded in the fetched source text). The article
# is saved to the Notion page body and to local markdown files.
WRITE_ARTICLES=1        # set to 0 to disable full-article generation
MAX_ARTICLES=20         # cap on articles written per run (protects Gemini quota)
ARTICLES_DIR=articles   # local folder for generated .md files (gitignored)
